let points = [];
let canvas;
let current = 0;
let spur = false;
let speed = 10;
const ADMIN_PASSWORD = "Topteam";
const EXTRA_INFO_EMPTY_COLOR = "#808080"; // Kleur van de knop als er geen commentaar is ingevuld.
let adminUnlocked = false;
let extraInfoFileHandle = null;
let extraInfoNotes = null;
let extraInfoNotesLoaded = false;
let extraInfoNotesLoadFailed = false;
let extraInfoNotesLoadPromise = null;


function onclick(x, y) {
}

let touchstartX = 0
let touchstartY = 0

document.addEventListener('touchstart', e => {
    touchstartX = e.changedTouches[0].screenX;
    touchstartY = e.changedTouches[0].screenY;
})

document.addEventListener('touchend', e => {
    let swipeX = e.changedTouches[0].screenX - touchstartX;
    let swipeY = e.changedTouches[0].screenY - touchstartY;
    if (Math.abs(swipeX) > Math.abs(swipeY)) {
        if (swipeX < -2) next();
        if (swipeX > 2) prev();
    }
})

function onmove(x, y) {

}

function onkey(e) {
    e = e || window.event;

    if (e.keyCode == '38') {
        prev();
    } else if (e.keyCode == '40') {
        next();
    } else if (e.keyCode == '37') {
        prev();
    } else if (e.keyCode == '39') {
        next();
    }
}

function getExtraInfoKey(image) {
    return "iiamw-extra-info-" + Number(image.order);
}

function isLocalPage() {
    return window.location.protocol === "file:";
}

function parseExtraInfoNotes(notes) {
    if (!notes || typeof notes !== "object" || Array.isArray(notes)) {
        throw new Error("Het JSON-bestand heeft niet het verwachte formaat.");
    }

    for (const [key, note] of Object.entries(notes)) {
        const orderKey = key.match(/^iiamw-extra-info-(\d+)$/);
        let stableKey;
        if (orderKey) {
            const image = BILDER.find(image => Number(image.order) === Number(orderKey[1]));
            if (image) {
                stableKey = getExtraInfoKey(image);
            } else {
                const legacyImage = BILDER[Number(orderKey[1])];
                if (legacyImage) {
                    stableKey = getExtraInfoKey(legacyImage);
                }
            }
        } else {
            const compositeKey = key.match(/^iiamw-extra-info-[^-]+-(\d+)-/);
            const image = compositeKey && BILDER.find(image => Number(image.order) === Number(compositeKey[1]));
            if (image) {
                stableKey = getExtraInfoKey(image);
            }
        }

        if (!stableKey || stableKey === key) {
            continue;
        }

        if (!Object.prototype.hasOwnProperty.call(notes, stableKey)) {
            notes[stableKey] = note;
        }
        delete notes[key];
    }

    return notes;
}

async function readExtraInfoFile(fileHandle) {
    const file = await fileHandle.getFile();
    const notes = JSON.parse(await file.text());
    return parseExtraInfoNotes(notes);
}

async function writeExtraInfoFile(fileHandle, notes) {
    const writable = await fileHandle.createWritable();
    await writable.write(JSON.stringify(notes, null, 2));
    await writable.close();
}

async function loadExtraInfoNotes() {
    if (extraInfoFileHandle) {
        const permission = await extraInfoFileHandle.queryPermission({ mode: "readwrite" });
        if (permission === "granted") {
            return await readExtraInfoFile(extraInfoFileHandle);
        }
        extraInfoFileHandle = null;
    }

    if (!isLocalPage()) {
        const response = await fetch("./extra-info.json", { cache: "no-store" });
        if (!response.ok) {
            throw new Error("extra-info.json kon niet worden geladen (HTTP " + response.status + ").");
        }
        return parseExtraInfoNotes(await response.json());
    }

    if (!extraInfoFileHandle) {
        return null;
    }

    return null;
}

async function chooseExtraInfoFile() {
    if (!window.showOpenFilePicker) {
        throw new Error("Bestanden kiezen wordt niet ondersteund. Open de pagina in Chrome of Edge.");
    }

    const [fileHandle] = await window.showOpenFilePicker({
        multiple: false,
        types: [{
            description: "JSON-bestand",
            accept: { "application/json": [".json"] }
        }]
    });
    let permission = await fileHandle.queryPermission({ mode: "readwrite" });
    if (permission !== "granted") {
        permission = await fileHandle.requestPermission({ mode: "readwrite" });
    }
    if (permission !== "granted") {
        throw new Error("Geen toestemming om het gekozen bestand te lezen en te bewerken.");
    }

    await readExtraInfoFile(fileHandle);
    extraInfoFileHandle = fileHandle;
    return fileHandle;
}

function ensureAdminDialog() {
    let dialog = document.getElementById("adminLoginDialog");
    if (dialog) {
        return dialog;
    }

    dialog = document.createElement("dialog");
    dialog.id = "adminLoginDialog";
    dialog.setAttribute("aria-labelledby", "adminLoginTitle");
    dialog.style.width = "min(90vw, 360px)";
    dialog.style.border = "1px solid #888";
    dialog.style.padding = "20px";

    const form = document.createElement("form");
    form.method = "dialog";

    const title = document.createElement("h2");
    title.id = "adminLoginTitle";
    title.innerText = "Admin-login";

    const label = document.createElement("label");
    label.htmlFor = "adminPassword";
    label.innerText = "Wachtwoord";

    const passwordRow = document.createElement("div");
    passwordRow.style.display = "flex";
    passwordRow.style.gap = "8px";
    passwordRow.style.marginTop = "8px";

    const passwordInput = document.createElement("input");
    passwordInput.id = "adminPassword";
    passwordInput.type = "password";
    passwordInput.autocomplete = "current-password";
    passwordInput.required = true;
    passwordInput.style.flex = "1";

    const revealButton = document.createElement("button");
    revealButton.type = "button";
    revealButton.style.display = "inline-flex";
    revealButton.style.alignItems = "center";
    revealButton.style.justifyContent = "center";
    revealButton.setAttribute("aria-label", "Wachtwoord tonen");
    revealButton.setAttribute("aria-pressed", "false");
    revealButton.title = "Wachtwoord tonen";

    const eyeIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    eyeIcon.setAttribute("viewBox", "0 0 24 24");
    eyeIcon.setAttribute("width", "20");
    eyeIcon.setAttribute("height", "20");
    eyeIcon.setAttribute("aria-hidden", "true");
    eyeIcon.setAttribute("fill", "none");
    eyeIcon.setAttribute("stroke", "currentColor");
    eyeIcon.setAttribute("stroke-width", "2");
    eyeIcon.setAttribute("stroke-linecap", "round");
    eyeIcon.setAttribute("stroke-linejoin", "round");

    const eyeOutline = document.createElementNS("http://www.w3.org/2000/svg", "path");
    eyeOutline.setAttribute("d", "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z");
    const eyePupil = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    eyePupil.setAttribute("cx", "12");
    eyePupil.setAttribute("cy", "12");
    eyePupil.setAttribute("r", "3");
    const eyeSlash = document.createElementNS("http://www.w3.org/2000/svg", "path");
    eyeSlash.setAttribute("d", "M3 3l18 18");
    eyeSlash.hidden = true;
    eyeIcon.append(eyeOutline, eyePupil, eyeSlash);
    revealButton.appendChild(eyeIcon);

    revealButton.addEventListener("click", function () {
        const reveal = passwordInput.type === "password";
        passwordInput.type = reveal ? "text" : "password";
        eyeSlash.hidden = !reveal;
        revealButton.setAttribute("aria-label", reveal ? "Wachtwoord verbergen" : "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", String(reveal));
        revealButton.title = reveal ? "Wachtwoord verbergen" : "Wachtwoord tonen";
        passwordInput.focus();
    });

    const actions = document.createElement("div");
    actions.style.display = "flex";
    actions.style.justifyContent = "flex-end";
    actions.style.gap = "8px";
    actions.style.marginTop = "16px";

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.innerText = "Annuleren";
    cancelButton.addEventListener("click", function () {
        dialog.close();
    });

    const submitButton = document.createElement("button");
    submitButton.type = "submit";
    submitButton.value = "login";
    submitButton.innerText = "Inloggen";

    form.addEventListener("submit", function (event) {
        event.preventDefault();
        const enteredPassword = passwordInput.value;
        passwordInput.value = "";
        passwordInput.type = "password";
        eyeSlash.hidden = true;
        revealButton.setAttribute("aria-label", "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", "false");
        revealButton.title = "Wachtwoord tonen";
        dialog.close();

        if (enteredPassword !== ADMIN_PASSWORD) {
            window.alert("Onjuist wachtwoord.");
            return;
        }

        adminUnlocked = true;
        refresh();
    });

    passwordRow.append(passwordInput, revealButton);
    actions.append(cancelButton, submitButton);
    form.append(title, label, passwordRow, actions);
    dialog.appendChild(form);
    dialog.addEventListener("close", function () {
        passwordInput.value = "";
        passwordInput.type = "password";
        eyeSlash.hidden = true;
        revealButton.setAttribute("aria-label", "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", "false");
        revealButton.title = "Wachtwoord tonen";
    });
    document.body.appendChild(dialog);
    return dialog;
}

function unlockAdmin() {
    const dialog = ensureAdminDialog();
    dialog.showModal();
    document.getElementById("adminPassword").focus();
}

function ensureExtraInfoControls() {
    if (document.getElementById("extraInfoButton")) {
        return;
    }

    const info = document.getElementById("bildinfo");
    if (!info) {
        return;
    }

    const button = document.createElement("button");
    button.id = "extraInfoButton";
    button.type = "button";
    button.className = "distance-button";
    button.innerText = "Extra info";
    button.addEventListener("click", openExtraInfoDialog);
    info.insertAdjacentElement("afterend", button);

    const dialog = document.createElement("dialog");
    dialog.id = "extraInfoDialog";
    dialog.setAttribute("aria-labelledby", "extraInfoTitle");
    dialog.style.width = "min(90vw, 720px)";
    dialog.style.border = "1px solid #888";
    dialog.style.padding = "20px";

    const title = document.createElement("h2");
    title.id = "extraInfoTitle";
    title.innerText = "Extra info";

    const fileNotice = document.createElement("p");
    fileNotice.id = "extraInfoNotice";

    const textarea = document.createElement("textarea");
    textarea.id = "extraInfoText";
    textarea.setAttribute("aria-label", "Bijkomende info");
    textarea.rows = 16;
    textarea.style.width = "100%";
    textarea.style.boxSizing = "border-box";

    const selectFileButton = document.createElement("button");
    selectFileButton.id = "extraInfoSelectFile";
    selectFileButton.type = "button";
    selectFileButton.innerText = "Kies Drive-bestand";
    selectFileButton.addEventListener("click", selectExtraInfoFile);

    const actions = document.createElement("div");
    actions.style.display = "flex";
    actions.style.justifyContent = "flex-end";
    actions.style.gap = "8px";
    actions.style.marginTop = "12px";

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.innerText = "Annuleren";
    cancelButton.addEventListener("click", function () {
        dialog.close();
    });

    const saveButton = document.createElement("button");
    saveButton.id = "extraInfoSave";
    saveButton.type = "button";
    saveButton.innerText = "Bewaren";
    saveButton.addEventListener("click", saveExtraInfo);

    actions.append(selectFileButton, cancelButton, saveButton);
    dialog.append(title, fileNotice, textarea, actions);
    document.body.appendChild(dialog);
}

function updateExtraInfoButtonColor() {
    const button = document.getElementById("extraInfoButton");
    if (!button || current >= BILDER.length) {
        return;
    }

    if (!extraInfoNotesLoaded) {
        if (extraInfoNotesLoadFailed || extraInfoNotesLoadPromise) {
            return;
        }

        extraInfoNotesLoadPromise = loadExtraInfoNotes()
            .then(notes => {
                extraInfoNotes = notes;
                extraInfoNotesLoaded = true;
                button.title = "Extra info";
                updateExtraInfoButtonColor();
            })
            .catch(error => {
                extraInfoNotesLoadFailed = true;
                button.title = "De opmerkingenstatus kon niet worden geladen.";
                console.error("De opmerkingenstatus kon niet worden geladen:", error);
            })
            .finally(() => {
                extraInfoNotesLoadPromise = null;
            });
        return;
    }

    const note = extraInfoNotes && extraInfoNotes[getExtraInfoKey(BILDER[current])];
    button.title = typeof note === "string" && note.trim()
        ? note
        : "Geen extra info.";
    button.style.backgroundColor = typeof note === "string" && note.trim()
        ? ""
        : EXTRA_INFO_EMPTY_COLOR;
}

async function openExtraInfoDialog() {
    const dialog = document.getElementById("extraInfoDialog");
    const textarea = document.getElementById("extraInfoText");
    const notice = document.getElementById("extraInfoNotice");
    const selectFileButton = document.getElementById("extraInfoSelectFile");
    const saveButton = document.getElementById("extraInfoSave");

    dialog.dataset.imageIndex = current;
    textarea.value = "";
    textarea.readOnly = true;
    selectFileButton.hidden = Boolean(extraInfoFileHandle);
    saveButton.hidden = true;
    notice.innerText = isLocalPage()
        ? "Je bent gekoppeld met de juiste Drive. Je kan je gegevens bewaren door op 'Bewaren' te klikken. Publiceer na eventuele wijzigingen ook het JSON-bestand naar GitHub om ze online zichtbaar te maken."
        : "Online kunnen de opmerkingen niet aangepast worden.";
    dialog.showModal();

    try {
        const notes = await loadExtraInfoNotes();
        extraInfoNotes = notes;
        extraInfoNotesLoaded = true;
        extraInfoNotesLoadFailed = false;
        selectFileButton.hidden = Boolean(extraInfoFileHandle);
        updateExtraInfoButtonColor();
        if (notes) {
            textarea.value = notes[getExtraInfoKey(BILDER[current])] || "";
            textarea.readOnly = !extraInfoFileHandle;
            saveButton.hidden = !extraInfoFileHandle;
        } else {
            notice.innerText = "Om extra info te kunnen bewaren: kies het gedeelde bestand extra-info.json in Google Drive Libalforteformatie@gmail.com in folder 'Is it a man's world' om opmerkingen te kunnen lezen en te bewerken.";
        }
    } catch (error) {
        selectFileButton.hidden = Boolean(extraInfoFileHandle);
        if (isLocalPage()) {
            notice.innerText = "Het bestand kon niet worden geladen. Kies het gedeelde JSON-bestand opnieuw.";
            window.alert("De extra info kon niet worden geladen: " + error.message);
        } else {
            notice.innerText = "Online opmerkingen konden niet worden geladen (" + error.message + "). Kies het gedeelde Drive-bestand om ze te lezen of te bewerken.";
        }
    }
    textarea.focus();
}

async function selectExtraInfoFile() {
    const dialog = document.getElementById("extraInfoDialog");
    const textarea = document.getElementById("extraInfoText");
    const notice = document.getElementById("extraInfoNotice");
    try {
        const fileHandle = await chooseExtraInfoFile();
        const notes = await readExtraInfoFile(fileHandle);
        extraInfoNotes = notes;
        extraInfoNotesLoaded = true;
        extraInfoNotesLoadFailed = false;
        document.getElementById("extraInfoSelectFile").hidden = true;
        const image = BILDER[Number(dialog.dataset.imageIndex)];
        textarea.value = notes[getExtraInfoKey(image)] || "";
        updateExtraInfoButtonColor();
        textarea.readOnly = false;
        document.getElementById("extraInfoSave").hidden = false;
        notice.innerText = "Drive-bestand gekozen. Wijzigingen worden daarin bewaard; publiceer het JSON-bestand ook naar GitHub voor de online versie.";
    } catch (error) {
        if (error.name !== "AbortError") {
            window.alert("Het Drive-bestand kon niet worden geopend: " + error.message);
        }
    }
}

async function saveExtraInfo() {
    const dialog = document.getElementById("extraInfoDialog");
    const textarea = document.getElementById("extraInfoText");
    try {
        if (!extraInfoFileHandle) {
            throw new Error("Kies eerst het gedeelde Drive-bestand.");
        }

        let permission = await extraInfoFileHandle.queryPermission({ mode: "readwrite" });
        if (permission !== "granted") {
            permission = await extraInfoFileHandle.requestPermission({ mode: "readwrite" });
        }
        if (permission !== "granted") {
            throw new Error("Geen toestemming om het Drive-bestand te bewerken. Kies het bestand opnieuw.");
        }

        const notes = await readExtraInfoFile(extraInfoFileHandle);
        const image = BILDER[Number(dialog.dataset.imageIndex)];
        const key = getExtraInfoKey(image);
        if (textarea.value.trim()) {
            notes[key] = textarea.value;
        } else {
            delete notes[key];
        }
        await writeExtraInfoFile(extraInfoFileHandle, notes);
        extraInfoNotes = notes;
        extraInfoNotesLoaded = true;
        extraInfoNotesLoadFailed = false;
        updateExtraInfoButtonColor();
        document.getElementById("extraInfoNotice").innerText = "Opgeslagen in het Drive-bestand. Publiceer het JSON-bestand ook naar GitHub voor de online versie.";
        dialog.close();
    } catch (error) {
        window.alert("De extra info kon niet worden bewaard: " + error.message);
    }
}

function refresh() {
    ensureExtraInfoControls();
    const extraInfoButton = document.getElementById("extraInfoButton");
    if (extraInfoButton) {
        extraInfoButton.hidden = !adminUnlocked || current >= BILDER.length;
    }
    updateExtraInfoButtonColor();
    const distanceButton = document.getElementById("distanceButton");
    if (distanceButton) {
        distanceButton.hidden = !adminUnlocked || current >= BILDER.length;
    }

    const totalsPage = document.getElementById("totalsPage");
    const canvasWrapper = document.querySelector(".canvas-wrapper");

    if (current === BILDER.length) {
        canvasWrapper.style.display = "none";
        totalsPage.style.display = "block";
        document.getElementById("bildinfo").innerText = "Totale afstanden";
        renderTotalDistances();
        return;
    }

    canvasWrapper.style.display = "flex";
    totalsPage.style.display = "none";
    points = BILDER[current].points;
    document.getElementById("bildinfo").innerText = BILDER[current].drittel + " - " + BILDER[current].tanz + " - " + BILDER[current].name;
    const nextBildinfo = document.getElementById("nextBildinfo");
    if (current + 1 < BILDER.length) {
        const nextImage = BILDER[current + 1];
        nextBildinfo.innerText = nextImage.drittel + " - " + nextImage.tanz + " - " + nextImage.name;
    } else {
        nextBildinfo.innerText = "Geen volgend beeld";
    }

    // Teken het huidige beeld links
    drawBoard(canvas1, BILDER[current].points);

    // Controleer of er een volgend beeld is en teken dit rechts
    if (current + 1 < BILDER.length) {
        drawBoard(canvas2, BILDER[current + 1].points);
    } else {
        drawBoard(canvas2, null); // Maak de vloer leeg/verwijder poppetjes als we aan het einde zijn
    }
}

function getPositionDistance(startPoints, targetPoints, position) {
    const start = getPoint(startPoints, position);
    const target = getPoint(targetPoints, position);
    return Math.hypot(target.x - start.x, target.y - start.y);
}

function renderTotalDistances() {
    const list = document.getElementById("totalDistanceList");
    list.innerHTML = "";

    for (let position = 1; position <= numPositions; position++) {
        let totalDistance = 0;
        for (let image = 0; image < BILDER.length - 1; image++) {
            totalDistance += getPositionDistance(BILDER[image].points, BILDER[image + 1].points, position);
        }

        const item = document.createElement("li");
        item.innerText = "Positie " + position + ": " + totalDistance.toFixed(2) + " m";
        item.style.color = POINT_COLORS[position - 1];
        list.appendChild(item);
    }
}

function openDistanceModal() {
    const modal = document.getElementById("distanceModal");
    const description = document.getElementById("distanceModalDescription");
    const list = document.getElementById("distanceList");

    list.innerHTML = "";
    if (current >= BILDER.length - 1) {
        description.innerText = "Er is geen volgend beeld.";
    } else {
        const currentPoints = BILDER[current].points;
        const nextPoints = BILDER[current + 1].points;
        description.innerText = "Van " + BILDER[current].name + " naar " + BILDER[current + 1].name + ".";

        const distances = [];
        for (let position = 1; position <= numPositions; position++) {
            const start = getPoint(currentPoints, position);
            const target = getPoint(nextPoints, position);
            distances.push({
                position,
                distance: Math.hypot(target.x - start.x, target.y - start.y)
            });
        }

        const maxDistance = Math.max(...distances.map(item => item.distance));
        const minDistance = Math.min(...distances.map(item => item.distance));
        for (const { position, distance } of distances) {
            const item = document.createElement("li");
            let label = "";
            if (distance === maxDistance) {
                label += " (MAX)";
            }
            if (distance === minDistance) {
                label += " (min)";
            }
            item.innerText = "Positie " + position + ": " + distance.toFixed(2) + " m" + label;
            item.style.color = POINT_COLORS[position - 1];
            list.appendChild(item);
        }
    }

    modal.classList.add("open");
}

function closeDistanceModal() {
    document.getElementById("distanceModal").classList.remove("open");
}

document.addEventListener("click", function (event) {
    if (event.target.id === "distanceModal") {
        closeDistanceModal();
    }
});

function prevdrittel() {
    inAnimation = false;
    if (current === BILDER.length) {
        current--;
    }
    if (current > 0) {
        if (BILDER[current].drittel !== BILDER[current - 1].drittel) {
            current--;
        }
        while (current > 0 && BILDER[current].drittel === BILDER[current - 1].drittel) {
            current--;
        }
        refresh();
    }
}

function nextdrittel() {
    inAnimation = false;
    if (current === BILDER.length) {
        return;
    }
    if (current < BILDER.length - 1) {
        while (current < BILDER.length - 1 && BILDER[current].drittel === BILDER[current + 1].drittel) {
            current++;
        }
        if (current < BILDER.length - 1) {
            current++;
        }
        refresh();
    }
}

function prevtanz() {
    inAnimation = false;
    if (current === BILDER.length) {
        current--;
    }
    if (current > 0) {
        if (BILDER[current].tanz !== BILDER[current - 1].tanz) {
            current--;
        }
        while (current > 0 && BILDER[current].tanz === BILDER[current - 1].tanz) {
            current--;
        }
        refresh();
    }
}

function nexttanz() {
    inAnimation = false;
    if (current === BILDER.length) {
        return;
    }
    if (current < BILDER.length - 1) {
        while (current < BILDER.length - 1 && BILDER[current].tanz === BILDER[current + 1].tanz) {
            current++;
        }
        if (current < BILDER.length - 1) {
            current++;
        }
        refresh();
    }
}

function getPoint(positions, number) {
    for (const i in positions) {
        if (positions[i].p == number) {
            return positions[i];
        }
    }
}

function animateNext(playmode) {
    if (inAnimation || current >= BILDER.length) {
        return;
    }
    if (current === BILDER.length - 1) {
        next();
        return;
    }
    let steps = 100;
    
    // Animatiedoelen voor het LINKER canvas
    let start1 = BILDER[current].points;
    let target1 = BILDER[current + 1].points;

    // Animatiedoelen voor het RECHTER canvas
    let start2 = null;
    let target2 = null;
    if (current + 2 < BILDER.length) {
        start2 = BILDER[current + 1].points;
        target2 = BILDER[current + 2].points;
    }

    let startO1 = [];
    let targetO1 = [];
    let maxdistsq = 0;

    for (let i = 0; i < numPositions; i++) {
        startO1[i] = getPoint(start1, i + 1);
        targetO1[i] = getPoint(target1, i + 1);
        
        let distsq = (targetO1[i].x - startO1[i].x) * (targetO1[i].x - startO1[i].x) + (targetO1[i].y - startO1[i].y) * (targetO1[i].y - startO1[i].y);
        
        if (targetO1[i].dx !== undefined || targetO1[i].dy !== undefined || startO1[i].dx !== undefined || startO1[i].dy !== undefined) {
            if (targetO1[i].dx === undefined || targetO1[i].dy === undefined) {
                targetO1[i].dx = targetO1[i].x;
                targetO1[i].dy = targetO1[i].y;
            }
            if (startO1[i].dx === undefined || startO1[i].dy === undefined) {
                startO1[i].dx = startO1[i].x;
                startO1[i].dy = startO1[i].y;
            }
            let distsqD = (targetO1[i].dx - startO1[i].dx) * (targetO1[i].dx - startO1[i].dx) + (targetO1[i].dy - startO1[i].dy) * (targetO1[i].dy - startO1[i].dy);
            if (maxdistsq < distsqD) {
                maxdistsq = distsqD;
            }
        }
        if (maxdistsq < distsq) {
            maxdistsq = distsq;
        }
    }
    steps = (Math.sqrt(maxdistsq) + 2) * (30 / speed);

    let startO2 = [];
    let targetO2 = [];
    if (start2 && target2) {
        for (let i = 0; i < numPositions; i++) {
            startO2[i] = getPoint(start2, i + 1);
            targetO2[i] = getPoint(target2, i + 1);
        }
    }

    inAnimation = true;
    animationStepBoth(startO1, targetO1, startO2, targetO2, 0, steps, playmode);
}

// Hulpfunctie om vloeiende puntberekeningen overzichtelijk te houden
function calculateInterpolated(startO, targetO, w, steps) {
    let pts = [];
    for (let i = 0; i < numPositions; i++) {
        let linPoint = {
            "p": startO[i].p,
            "x": ((targetO[i].x * w) + (startO[i].x * (steps - w))) / steps,
            "y": ((targetO[i].y * w) + (startO[i].y * (steps - w))) / steps
        }
        if (targetO[i].dx !== undefined || targetO[i].dy !== undefined || startO[i].dx !== undefined || startO[i].dy !== undefined) {
            if (targetO[i].dx === undefined || targetO[i].dy === undefined) {
                targetO[i].dx = targetO[i].x;
                targetO[i].dy = targetO[i].y;
            }
            if (startO[i].dx === undefined || startO[i].dy === undefined) {
                startO[i].dx = startO[i].x;
                startO[i].dy = startO[i].y;
            }
            linPoint.dx = ((targetO[i].dx * w) + (startO[i].dx * (steps - w))) / steps;
            linPoint.dy = ((targetO[i].dy * w) + (startO[i].dy * (steps - w))) / steps;
        }
        pts[i] = linPoint;
    }
    return pts;
}

// Verwerkt frames synchroon op zowel het linker als het rechter canvas
function animationStepBoth(startO1, targetO1, startO2, targetO2, w, steps, playmode) {
    if (!inAnimation) return;
    
    if (w >= steps) {
        inAnimation = false;
        next();
        if (playmode) {
            setTimeout(() => animateNext(true), 200);
        }
        return;
    }

    let pts1 = calculateInterpolated(startO1, targetO1, w, steps);
    drawBoard(canvas1, pts1);

    if (startO2.length > 0 && targetO2.length > 0) {
        let pts2 = calculateInterpolated(startO2, targetO2, w, steps);
        drawBoard(canvas2, pts2);
    } else {
        drawBoard(canvas2, null);
    }

    // Ondersteuning voor de spoor-lijnen (spur) mocht je dat in de toekomst weer aanzetten
    if (spur) {
        const ctx1 = canvas1.getContext("2d");
        ctx1.beginPath();
        for (let i = 0; i < numPositions; i++) {
            ctx1.moveTo(0.5 + coordToGrid(startO1[i].x), 0.5 + coordToGrid(startO1[i].y));
            ctx1.lineTo(0.5 + coordToGrid(targetO1[i].x), 0.5 + coordToGrid(targetO1[i].y));
        }
        ctx1.strokeStyle = COLOR;
        ctx1.stroke();

        if (startO2.length > 0 && targetO2.length > 0) {
            const ctx2 = canvas2.getContext("2d");
            ctx2.beginPath();
            for (let i = 0; i < numPositions; i++) {
                ctx2.moveTo(0.5 + coordToGrid(startO2[i].x), 0.5 + coordToGrid(startO2[i].y));
                ctx2.lineTo(0.5 + coordToGrid(targetO2[i].x), 0.5 + coordToGrid(targetO2[i].y));
            }
            ctx2.strokeStyle = COLOR;
            ctx2.stroke();
        }
    }

    setTimeout(() => animationStepBoth(startO1, targetO1, startO2, targetO2, w + 1, steps, playmode), 16);
}

function animatePrev(playmode) {
    if (inAnimation || current <= 0) {
        return;
    }
    if (current === BILDER.length) {
        prev();
        return;
    }
    let steps = 100;
    
    // Animatiedoelen voor het LINKER canvas (huidig -> vorig)
    let start1 = BILDER[current].points;
    let target1 = BILDER[current - 1].points;

    // Animatiedoelen voor het RECHTER canvas (volgend -> huidig)
    let start2 = null;
    let target2 = null;
    if (current + 1 < BILDER.length) {
        start2 = BILDER[current + 1].points;
        target2 = BILDER[current].points;
    }

    let startO1 = [];
    let targetO1 = [];
    let maxdistsq = 0;

    for (let i = 0; i < numPositions; i++) {
        startO1[i] = getPoint(start1, i + 1);
        targetO1[i] = getPoint(target1, i + 1);
        
        let distsq = (targetO1[i].x - startO1[i].x) * (targetO1[i].x - startO1[i].x) + (targetO1[i].y - startO1[i].y) * (targetO1[i].y - startO1[i].y);
        if (targetO1[i].dx !== undefined || targetO1[i].dy !== undefined || startO1[i].dx !== undefined || startO1[i].dy !== undefined) {
            if (targetO1[i].dx === undefined || targetO1[i].dy === undefined) {
                targetO1[i].dx = targetO1[i].x;
                targetO1[i].dy = targetO1[i].y;
            }
            if (startO1[i].dx === undefined || startO1[i].dy === undefined) {
                startO1[i].dx = startO1[i].x;
                startO1[i].dy = startO1[i].y;
            }
            let distsqD = (targetO1[i].dx - startO1[i].dx) * (targetO1[i].dx - startO1[i].dx) + (targetO1[i].dy - startO1[i].dy) * (targetO1[i].dy - startO1[i].dy);
            if (maxdistsq < distsqD) {
                maxdistsq = distsqD;
            }
        }
        if (maxdistsq < distsq) {
            maxdistsq = distsq;
        }
    }
    steps = (Math.sqrt(maxdistsq) + 2) * (30 / speed);

    let startO2 = [];
    let targetO2 = [];
    if (start2 && target2) {
        for (let i = 0; i < numPositions; i++) {
            startO2[i] = getPoint(start2, i + 1);
            targetO2[i] = getPoint(target2, i + 1);
        }
    }

    inAnimation = true;
    animationStepBothPrev(startO1, targetO1, startO2, targetO2, 0, steps, playmode);
}

// Speciale loop functie voor het achteruit animeren
function animationStepBothPrev(startO1, targetO1, startO2, targetO2, w, steps, playmode) {
    if (!inAnimation) return;
    if (w >= steps) {
        inAnimation = false;
        prev(); // Let op: hier roepen we prev() aan in plaats van next()
        if (playmode) {
            setTimeout(() => animatePrev(true), 200);
        }
        return;
    }

    let pts1 = calculateInterpolated(startO1, targetO1, w, steps);
    drawBoard(canvas1, pts1);

    if (startO2.length > 0 && targetO2.length > 0) {
        let pts2 = calculateInterpolated(startO2, targetO2, w, steps);
        drawBoard(canvas2, pts2);
    } else {
        drawBoard(canvas2, null);
    }

    if (spur) {
        const ctx1 = canvas1.getContext("2d");
        ctx1.beginPath();
        for (let i = 0; i < numPositions; i++) {
            ctx1.moveTo(0.5 + coordToGrid(startO1[i].x), 0.5 + coordToGrid(startO1[i].y));
            ctx1.lineTo(0.5 + coordToGrid(targetO1[i].x), 0.5 + coordToGrid(targetO1[i].y));
        }
        ctx1.strokeStyle = COLOR;
        ctx1.stroke();
        if (startO2.length > 0 && targetO2.length > 0) {
            const ctx2 = canvas2.getContext("2d");
            ctx2.beginPath();
            for (let i = 0; i < numPositions; i++) {
                ctx2.moveTo(0.5 + coordToGrid(startO2[i].x), 0.5 + coordToGrid(startO2[i].y));
                ctx2.lineTo(0.5 + coordToGrid(targetO2[i].x), 0.5 + coordToGrid(targetO2[i].y));
            }
            ctx2.strokeStyle = COLOR;
            ctx2.stroke();
        }
    }

    setTimeout(() => animationStepBothPrev(startO1, targetO1, startO2, targetO2, w + 1, steps, playmode), 16);
}
