const logoImage = new Image();
let adminUnlocked = false;
let extraInfoFileHandle = null;
let extraInfoNotes = null;
let extraInfoNotesLoaded = false;
let extraInfoNotesLoadFailed = false;
let extraInfoNotesLoadPromise = null;

logoImage.onload = function () {
    if (canvas1 && showLogoPage) {
        refresh();
    }
};
logoImage.src = new URL("../Logo.png", document.currentScript.src).href;


function onclick(x, y) {
}

let touchstartX = 0
let touchstartY = 0

document.addEventListener('touchstart', e => {
    touchstartX = e.changedTouches[0].screenX;
    touchstartY = e.changedTouches[0].screenY;
})

document.addEventListener('touchend', e => {
    let swipeX = e.changedTouches[0].screenX - touchstartX;
    let swipeY = e.changedTouches[0].screenY - touchstartY;
    if (Math.abs(swipeX) > Math.abs(swipeY)) {
        if (swipeX < -2) next();
        if (swipeX > 2) prev();
    }
})

function onmove(x, y) {

}

function onkey(e) {
    e = e || window.event;

    if (e.keyCode == '38') {
        prev();
    } else if (e.keyCode == '40') {
        next();
    } else if (e.keyCode == '37') {
        prev();
    } else if (e.keyCode == '39') {
        next();
    }
}

function getExtraInfoKey(image) {
    return "iiamw-extra-info-" + Number(image.order);
}

function isLocalPage() {
    return window.location.protocol === "file:";
}

function parseExtraInfoNotes(notes) {
    if (!notes || typeof notes !== "object" || Array.isArray(notes)) {
        throw new Error("Het JSON-bestand heeft niet het verwachte formaat.");
    }

    for (const [key, note] of Object.entries(notes)) {
        const orderKey = key.match(/^iiamw-extra-info-(\d+)$/);
        let stableKey;
        if (orderKey) {
            const image = BILDER.find(image => Number(image.order) === Number(orderKey[1]));
            if (image) {
                stableKey = getExtraInfoKey(image);
            } else {
                const legacyImage = BILDER[Number(orderKey[1])];
                if (legacyImage) {
                    stableKey = getExtraInfoKey(legacyImage);
                }
            }
        } else {
            const compositeKey = key.match(/^iiamw-extra-info-[^-]+-(\d+)-/);
            const image = compositeKey && BILDER.find(image => Number(image.order) === Number(compositeKey[1]));
            if (image) {
                stableKey = getExtraInfoKey(image);
            }
        }

        if (!stableKey || stableKey === key) {
            continue;
        }

        if (!Object.prototype.hasOwnProperty.call(notes, stableKey)) {
            notes[stableKey] = note;
        }
        delete notes[key];
    }

    return notes;
}

async function readExtraInfoFile(fileHandle) {
    const file = await fileHandle.getFile();
    const notes = JSON.parse(await file.text());
    return parseExtraInfoNotes(notes);
}

async function writeExtraInfoFile(fileHandle, notes) {
    const writable = await fileHandle.createWritable();
    await writable.write(JSON.stringify(notes, null, 2));
    await writable.close();
}

async function loadExtraInfoNotes() {
    if (extraInfoFileHandle) {
        const permission = await extraInfoFileHandle.queryPermission({ mode: "readwrite" });
        if (permission === "granted") {
            return await readExtraInfoFile(extraInfoFileHandle);
        }
        extraInfoFileHandle = null;
    }

    if (!isLocalPage()) {
        const response = await fetch("./extra-info.json", { cache: "no-store" });
        if (!response.ok) {
            throw new Error("extra-info.json kon niet worden geladen (HTTP " + response.status + ").");
        }
        return parseExtraInfoNotes(await response.json());
    }

    if (!extraInfoFileHandle) {
        return null;
    }

    return null;
}

async function chooseExtraInfoFile() {
    if (!window.showOpenFilePicker) {
        throw new Error("Bestanden kiezen wordt niet ondersteund. Open de pagina in Chrome of Edge.");
    }

    const [fileHandle] = await window.showOpenFilePicker({
        multiple: false,
        types: [{
            description: "JSON-bestand",
            accept: { "application/json": [".json"] }
        }]
    });
    let permission = await fileHandle.queryPermission({ mode: "readwrite" });
    if (permission !== "granted") {
        permission = await fileHandle.requestPermission({ mode: "readwrite" });
    }
    if (permission !== "granted") {
        throw new Error("Geen toestemming om het gekozen bestand te lezen en te bewerken.");
    }

    await readExtraInfoFile(fileHandle);
    extraInfoFileHandle = fileHandle;
    return fileHandle;
}

function ensureAdminDialog() {
    let dialog = document.getElementById("adminLoginDialog");
    if (dialog) {
        return dialog;
    }

    dialog = document.createElement("dialog");
    dialog.id = "adminLoginDialog";
    dialog.setAttribute("aria-labelledby", "adminLoginTitle");
    dialog.style.width = "min(90vw, 360px)";
    dialog.style.border = "1px solid #888";
    dialog.style.padding = "20px";

    const form = document.createElement("form");
    form.method = "dialog";

    const title = document.createElement("h2");
    title.id = "adminLoginTitle";
    title.innerText = "Admin-login";

    const label = document.createElement("label");
    label.htmlFor = "adminPassword";
    label.innerText = "Wachtwoord";

    const passwordRow = document.createElement("div");
    passwordRow.style.display = "flex";
    passwordRow.style.gap = "8px";
    passwordRow.style.marginTop = "8px";

    const passwordInput = document.createElement("input");
    passwordInput.id = "adminPassword";
    passwordInput.type = "password";
    passwordInput.autocomplete = "current-password";
    passwordInput.required = true;
    passwordInput.style.flex = "1";

    const revealButton = document.createElement("button");
    revealButton.type = "button";
    revealButton.style.display = "inline-flex";
    revealButton.style.alignItems = "center";
    revealButton.style.justifyContent = "center";
    revealButton.setAttribute("aria-label", "Wachtwoord tonen");
    revealButton.setAttribute("aria-pressed", "false");
    revealButton.title = "Wachtwoord tonen";

    const eyeIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    eyeIcon.setAttribute("viewBox", "0 0 24 24");
    eyeIcon.setAttribute("width", "20");
    eyeIcon.setAttribute("height", "20");
    eyeIcon.setAttribute("aria-hidden", "true");
    eyeIcon.setAttribute("fill", "none");
    eyeIcon.setAttribute("stroke", "currentColor");
    eyeIcon.setAttribute("stroke-width", "2");
    eyeIcon.setAttribute("stroke-linecap", "round");
    eyeIcon.setAttribute("stroke-linejoin", "round");

    const eyeOutline = document.createElementNS("http://www.w3.org/2000/svg", "path");
    eyeOutline.setAttribute("d", "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z");
    const eyePupil = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    eyePupil.setAttribute("cx", "12");
    eyePupil.setAttribute("cy", "12");
    eyePupil.setAttribute("r", "3");
    const eyeSlash = document.createElementNS("http://www.w3.org/2000/svg", "path");
    eyeSlash.setAttribute("d", "M3 3l18 18");
    eyeSlash.hidden = true;
    eyeIcon.append(eyeOutline, eyePupil, eyeSlash);
    revealButton.appendChild(eyeIcon);

    revealButton.addEventListener("click", function () {
        const reveal = passwordInput.type === "password";
        passwordInput.type = reveal ? "text" : "password";
        eyeSlash.hidden = !reveal;
        revealButton.setAttribute("aria-label", reveal ? "Wachtwoord verbergen" : "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", String(reveal));
        revealButton.title = reveal ? "Wachtwoord verbergen" : "Wachtwoord tonen";
        passwordInput.focus();
    });

    const actions = document.createElement("div");
    actions.style.display = "flex";
    actions.style.justifyContent = "flex-end";
    actions.style.gap = "8px";
    actions.style.marginTop = "16px";

    const cancelButton = document.createElement("button");
    cancelButton.type = "button";
    cancelButton.innerText = "Annuleren";
    cancelButton.addEventListener("click", function () {
        dialog.close();
    });

    const submitButton = document.createElement("button");
    submitButton.type = "submit";
    submitButton.value = "login";
    submitButton.innerText = "Inloggen";

    form.addEventListener("submit", function (event) {
        event.preventDefault();
        const enteredPassword = passwordInput.value;
        passwordInput.value = "";
        passwordInput.type = "password";
        eyeSlash.hidden = true;
        revealButton.setAttribute("aria-label", "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", "false");
        revealButton.title = "Wachtwoord tonen";
        dialog.close();

        if (enteredPassword !== ADMIN_PASSWORD) {
            window.alert("Onjuist wachtwoord.");
            return;
        }

        adminUnlocked = true;
        refresh();
    });

    passwordRow.append(passwordInput, revealButton);
    actions.append(cancelButton, submitButton);
    form.append(title, label, passwordRow, actions);
    dialog.appendChild(form);
    dialog.addEventListener("close", function () {
        passwordInput.value = "";
        passwordInput.type = "password";
        eyeSlash.hidden = true;
        revealButton.setAttribute("aria-label", "Wachtwoord tonen");
        revealButton.setAttribute("aria-pressed", "false");
        revealButton.title = "Wachtwoord tonen";
    });
    document.body.appendChild(dialog);
    return dialog;
}

function unlockAdmin() {
    const dialog = ensureAdminDialog();
    dialog.showModal();
    document.getElementById("adminPassword").focus();
}

